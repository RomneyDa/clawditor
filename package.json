{
  "name": "clawditor",
  "version": "0.1.0",
  "type": "module",
  "description": "One-command OpenClaw beta and release-candidate validation launcher.",
  "repository": {
    "type": "git",
    "url": "https://github.com/RomneyDa/clawditor.git"
  },
  "license": "MIT",
  "preferGlobal": true,
  "files": [
    "dist/",
    "prompts/",
    "src/",
    "AGENTS.md",
    "README.md",
    "package.json"
  ],
  "bin": {
    "clawditor": "dist/clawditor.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/clawditor.js', 0o755)\"",
    "test": "npm run build && node --test --import tsx test/*.test.ts",
    "prepack": "npm run build",
    "prepare": "node -e \"try{require('node:fs').chmodSync('dist/clawditor.js',0o755)}catch{}\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
